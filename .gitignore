# ======================================
# Python standard ignores
# ======================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cython debug symbols
cython_debug/

# ======================================
# Virtual environments
# ======================================
.venv/
venv/
ENV/
env/
Venv/
VENV/

# pyenv
.python-version

# pip wheel cache
*.egg-info/
dist/
build/
.eggs/
*.egg

# ======================================
# IDEs & editors
# ======================================
.vscode/
.idea/
*.swp
*.swo

# ======================================
# Logs and temp files
# ======================================
*.log
*.tmp
*.bak
*.orig
*.old

# ======================================
# OS-generated files
# ======================================
.DS_Store
Thumbs.db

# ======================================
# Tests and coverage
# ======================================
.coverage
coverage.xml
htmlcov/
.tox/
.pytest_cache/

# ======================================
# Custom project-specific ignores
# ======================================
*.zip
# local scratch file
sandbox.py

ingest/*/inputs/*
# each run's build, promoted to the repo only when the whole pipeline succeeds
ingest/staging/
!ingest/macroregions/inputs/macroregions.manifest.json
!ingest/currencies/inputs/currencies.manifest.json
!ingest/scripts/inputs/scripts.manifest.json
!ingest/languages/inputs/languages.manifest.json
!ingest/countries/inputs/countries.manifest.json
!ingest/countries/inputs/name_blocklist.json
!ingest/countries/inputs/wikidata_country_names.json
!ingest/subdivisions/inputs/subdivisions.manifest.json
!ingest/subdivisions/inputs/wikidata_crosswalk.json
!ingest/cities/inputs/cities.manifest.json
!ingest/shared/inputs/shared.manifest.json

# ingest outputs: tracked by default (resolution decisions, orphan lists)

# ingest logs: tracked so each run's diagnostics are reviewable in the ingest PR
!ingest/*/logs/*.log
!ingest/pipeline.log